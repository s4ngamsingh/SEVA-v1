# =============================================================================
# SEVA: Environment Configuration
# Duplicate this file and rename it to ".env"
# =============================================================================

# Your Google AI Studio Gemini API Key
# Get one for free at: https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# The local IP address assigned to your ESP32-S3 glasses by your phone hotspot
# Check the "Connected Devices" list on your phone hotspot settings
GLASSES_IP=192.168.43.100

# Model choice: gemini-1.5-flash or gemini-2.5-flash
GEMINI_MODEL=gemini-1.5-flash
